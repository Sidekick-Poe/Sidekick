@using Microsoft.Extensions.Options
@using Sidekick.Common
@using Sidekick.Web.Services

<Sidekick.Common.Ui.Main/>

@inject IServiceProvider ServiceProvider
@inject IOptions<SidekickConfiguration> Configuration
@implements IDisposable

@code {

    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    protected override void OnInitialized()
    {
        var viewLocator = ServiceProvider.GetService<WebViewLocator>();
        if (viewLocator != null)
        {
            viewLocator.Views.Add(this);
        }

        if (Configuration.Value.ApplicationType == SidekickApplicationType.Web)
        {
            _ = ServiceProvider.GetRequiredService<WebDialogsHandler>();
        }

        base.OnInitialized();
    }

    public void Dispose()
    {
        var viewLocator = ServiceProvider.GetService<WebViewLocator>();
        if (viewLocator != null)
        {
            viewLocator.Views.Remove(this);
        }
    }

}
