@using Sidekick.Modules.Items.Exchange.Localization
@using Sidekick.Game.Parser.Items
@using Sidekick.Common.Ui.Tabs

@if (SupportsCurrencyExchange)
{
    <TabItem Id="exchange"
             Text="@Resources["CurrencyExchange"]"/>
}

@inject IStringLocalizer<ExchangeResources> Resources

@code {

    [CascadingParameter]
    public required Item Item { get; set; }

    private bool SupportsCurrencyExchange
    {
        get
        {
            if (Item.Definition.NinjaExchangeItem != null) return true;
            if (Item.Definition.ScoutItems?.Any(x => x.IsCurrency) ?? false) return true;

            return false;
        }
    }
}