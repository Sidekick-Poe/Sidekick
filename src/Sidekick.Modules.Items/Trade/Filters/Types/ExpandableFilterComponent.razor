@using Sidekick.Apis.Poe.Trade.Trade.Results
@using Sidekick.Game.Parser.Filters.Types
@using Sidekick.Game.Parser.Items

<div class="group/filter-settings">
    <FilterWrapper Filter="@Filter" Absolute="true">
        <div
            class="grow flex flex-nowrap items-center min-h-5 justify-center gap-2 cursor-pointer @LineContentType.Simple.GetColour()"
            @onclick="() => Filter.Checked = !Filter.Checked"
            @onclick:preventDefault="true">
            <Icon Size="UiIconSize.Small"
                  Svg="@(Filter.Checked ? UiIcons.ChevronDown : UiIcons.ChevronRight)"/>

            @{
                var label = Filter.Text;
                if (CheckedFiltersWhenCollapsed > 0)
                {
                    label = $"{label} ({CheckedFiltersWhenCollapsed})";
                }
            }

            <ItemPropertyText Label="@label"
                              Hint="@Filter.Hint"
                              Value="@(Filter.Checked ? "true" : "false")"
                              ContentType="@Filter.GetLineContentType()"
                              OnlyShowLabel="true"/>

            <Icon Size="UiIconSize.Small"
                  Svg="@(Filter.Checked ? UiIcons.ChevronDown : UiIcons.ChevronLeft)"/>
        </div>
    </FilterWrapper>

    @for (var index = 0; index < Filter.Filters.Count; index++)
    {
        var filter = Filter.Filters[index];
        var key = $"{Item.Id}_filter_{index}";

        if (!Filter.Checked) continue;

        <FilterComponent @key="key"
                         Filter="filter"/>
    }
</div>

@code {

    [CascadingParameter]
    public required Item Item { get; set; }

    [Parameter]
    public required ExpandableFilter Filter { get; set; }

    private int CheckedFiltersWhenCollapsed
    {
        get
        {
            if (Filter.Checked) return 0;

            var selectedFilters = 0;
            foreach (var filter in Filter.Filters)
            {
                if (filter is TriStatePropertyFilter triState)
                {
                    if (triState.Checked != null) selectedFilters++;
                }
                else if (filter.Checked) selectedFilters++;
            }

            return selectedFilters;
        }
    }
}
