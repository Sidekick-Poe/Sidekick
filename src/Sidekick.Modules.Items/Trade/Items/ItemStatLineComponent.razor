@using Sidekick.Apis.Poe.Trade.Trade.Models
@using Sidekick.Apis.Poe.Trade.Trade.Results
@using Sidekick.Data.Extensions
@using Sidekick.Data.Stats

<TextBase Class="relative px-2 font-caps text-center text-[##8888FF] leading-none py-px">
    <ItemStatText Category="ComputedCategory">@Modifier.Description?.RemoveSquareBrackets()</ItemStatText>

    <span class="absolute top-0.5 left-[-6px] flex items-center gap-x-0.5">
        @foreach (var modifier in Modifier.Details)
        {
            if (string.IsNullOrWhiteSpace(modifier.Tier)) continue;

            if (Modifier.Details.IndexOf(modifier) != 0)
            {
                <span class="@GetTierClass(modifier.Tier)">+</span>
            }

            <span class="@GetTierClass(modifier.Tier)">@modifier.Tier</span>
        }
    </span>
</TextBase>

@code {

    [Parameter]
    public required TradeResult Result { get; set; }

    [Parameter]
    public required ApiItemModifier Modifier { get; set; }

    [Parameter]
    public required StatCategory Category { get; set; } = StatCategory.Explicit;

    private string GetTierClass(string tier) => tier.StartsWith("P") ? "text-[#ec7676]" : "text-[#7aaff1]";

    private StatCategory ComputedCategory
    {
        get
        {
            if (Modifier.Flags?.Mutated ?? false) return StatCategory.Mutated;
            if (Modifier.Flags?.Fractured ?? false) return StatCategory.Fractured;
            if (Modifier.Flags?.Crafted ?? false) return StatCategory.Crafted;
            if (Modifier.Flags?.Desecrated ?? false) return StatCategory.Desecrated;
            return Category;
        }
    }

    protected override bool ShouldRender() => false;

}
