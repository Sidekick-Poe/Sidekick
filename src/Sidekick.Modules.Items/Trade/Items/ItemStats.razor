@using Sidekick.Apis.Poe.Trade.Trade.Results
@using Sidekick.Data.Stats

<ItemSeparator Rarity="Result.Item.Rarity"/>

@foreach (var modifier in Result.Item.EnchantMods)
{
    <ItemStatLineComponent Result="Result" Category="StatCategory.Enchant" Modifier="modifier"/>
}

<ItemSeparator Rarity="Result.Item.Rarity"/>

@foreach (var modifier in Result.Item.RuneMods)
{
    <ItemStatLineComponent Result="Result" Category="StatCategory.Rune" Modifier="modifier"/>
}

<ItemSeparator Rarity="Result.Item.Rarity"/>

@foreach (var modifier in Result.Item.ImplicitMods)
{
    <ItemStatLineComponent Result="Result" Category="StatCategory.Implicit" Modifier="modifier"/>
}

<ItemSeparator Rarity="Result.Item.Rarity"/>

@foreach (var modifier in Result.Item.ExplicitMods)
{
    <ItemStatLineComponent Result="Result" Category="StatCategory.Explicit" Modifier="modifier"/>
}

@code {

    [Parameter]
    public required TradeResult Result { get; set; }

    protected override bool ShouldRender() => false;

}
