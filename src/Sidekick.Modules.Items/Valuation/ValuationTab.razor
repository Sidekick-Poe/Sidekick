@using Sidekick.Common
@using Sidekick.Common.Settings.Languages
@using Sidekick.Modules.Items.Valuation.Localization
@using Sidekick.Game
@using Sidekick.Game.Parser.Items
@using Sidekick.Common.Ui.Tabs

@if (Valid)
{
    <TabItem Id="valuation"
             Text="@Resources["Valuation"]"/>
}

@inject IStringLocalizer<ValuationResources> Resources
@inject ICurrentGameLanguage CurrentGameLanguage

@code {

    [CascadingParameter]
    public required Item Item { get; set; }

    private bool Valid { get; set; }

    protected override void OnInitialized()
    {
        Valid = CheckNinja();
        Valid |= CheckPrediction();
        Valid |= CheckScout();

        base.OnInitialized();
    }

    private bool CheckNinja()
    {
        if (Item.InvariantDefinition?.NinjaExchangeItem != null) return false;
        return Item.InvariantDefinition?.NinjaStashItems != null && Item.InvariantDefinition.NinjaStashItems.Count > 0;
    }

    private bool CheckPrediction()
    {
        if (!SidekickFlags.PoePricesEnabled) return false;

        return Item.Game == GameType.Poe1
               && Item.Properties.Rarity == Rarity.Rare
               && CurrentGameLanguage.IsEnglish();
    }

    private bool CheckScout()
    {
        return Item.Definition.ScoutItems != null && Item.Definition.ScoutItems.Any(x => !x.IsCurrency);
    }
}