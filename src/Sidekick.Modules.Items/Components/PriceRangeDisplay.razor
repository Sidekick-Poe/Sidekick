@using Sidekick.Game.ItemDefinitions
@using Sidekick.Game.Parser

<div class="flex flex-nowrap gap-1 items-center">
    <Heading2>@Min.ToString("0.#")</Heading2>
    <TextCaption Class="mx-1 text-[#a38d6d]">-</TextCaption>
    <Heading2>@Max.ToString("0.#")</Heading2>

    @if (Definition?.Image != null)
    {
        <TextBase Class="text-[#a38d6d]">&times;</TextBase>
        <Tooltip Placement="TooltipPlacement.Left" Text="@Definition.Name">
            <img src="@Definition.Image" class="max-h-10" alt="@Definition.Name"/>
        </Tooltip>
    }
</div>

@inject ItemDefinitionParser ItemDefinitionParser

@code {

    [Parameter]
    public string? Currency { get; set; }

    [Parameter]
    public double Min { get; set; }

    [Parameter]
    public double Max { get; set; }

    private ItemDefinition? Definition { get; set; }

    protected override void OnParametersSet()
    {
        Definition = ItemDefinitionParser.GetInvariant(Currency);
        base.OnParametersSet();
    }

}
