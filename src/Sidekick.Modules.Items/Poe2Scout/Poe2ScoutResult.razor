@using Sidekick.Apis.Poe2Scout.History
@using Sidekick.Apis.Poe2Scout.History.Models
@using Sidekick.Modules.Items.Poe2Scout.Localization
@using Sidekick.Game.Parser.Items

<div class="flex flex-col gap-2">
    <Heading2>
        <div class="flex flex-nowrap items-center gap-3">
            <img alt="Poe2Scout" src="@Assets["_content/Sidekick.Common.Ui/images/external-tools/scout-logo.png"]"
                 class="size-6"/>
            <span>Poe2Scout.com</span>
        </div>
    </Heading2>

    @if (Loading)
    {
        <AppLoading Label="Poe2Scout.com"/>
    }
    else if (Results == null || Results.Count == 0)
    {
        <AlertInfo Flat="true">@Resources["NoData"]</AlertInfo>
    }
    else
    {
        foreach (var result in Results)
        {
            if (result.Item.IsCurrency)
            {
                <Poe2ScoutCurrencyPanel History="result"/>
            }
            else
            {
                <Poe2ScoutStashPanel History="result"/>
            }
        }
    }
</div>

@inject ScoutHistoryProvider ScoutHistoryProvider
@inject IStringLocalizer<Poe2ScoutResources> Resources

@code {

    [CascadingParameter]
    public required Item Item { get; set; }

    private List<ScoutHistory>? Results { get; set; }

    private bool Loading { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        Loading = true;
        StateHasChanged();

        Results = await ScoutHistoryProvider.GetHistories(Item);

        Loading = false;
        StateHasChanged();

        await base.OnParametersSetAsync();
    }
}
