@using Sidekick.Apis.PoeNinja.Stash
@using Sidekick.Modules.Items.PoeNinja.Localization
@using Sidekick.Apis.PoeNinja.Exchange
@using Sidekick.Game.Parser.Items

@if (!(Item.InvariantDefinition?.NinjaExchangeItems?.Any() ?? false) && !(Item.InvariantDefinition?.NinjaStashItems?.Any() ?? false))
{
    return;
}

<div class="flex flex-col gap-2">
    <PoeNinjaHeader
        Tooltip="@(Item.Properties.Rarity is Rarity.Normal or Rarity.Magic or Rarity.Rare ? Resources["BaseType_Description"] : string.Empty)"/>

    @if (Loading)
    {
        <AppLoading/>
    }
    else if (Currencies.Count == 0 && Stashes.Count == 0)
    {
        <AlertInfo Flat="true">@Resources["NoData"]</AlertInfo>
    }

    @foreach (var currency in Currencies)
    {
        <PoeNinjaCurrencyPanel Currency="currency"/>
    }

    @foreach (var stash in Stashes)
    {
        <PoeNinjaStashPanel Stash="stash"/>
    }
</div>

@inject INinjaStashProvider NinjaStashProvider
@inject INinjaExchangeProvider NinjaExchangeProvider
@inject IStringLocalizer<PoeNinjaResources> Resources

@code {
    [CascadingParameter]
    public required Item Item { get; set; }

    private List<NinjaStash> Stashes { get; set; } = [];

    private List<NinjaCurrency> Currencies { get; set; } = [];

    private bool Loading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (Item.InvariantDefinition?.NinjaExchangeItems is { Count: > 0 })
        {
            Loading = true;
            StateHasChanged();

            Currencies = await NinjaExchangeProvider.GetInfo(Item);

            Loading = false;
            StateHasChanged();
        }
        else if (Item.InvariantDefinition?.NinjaStashItems is { Count: > 0 })
        {
            Loading = true;
            StateHasChanged();

            Stashes = await NinjaStashProvider.GetInfo(Item);

            Loading = false;
            StateHasChanged();
        }

    }
}