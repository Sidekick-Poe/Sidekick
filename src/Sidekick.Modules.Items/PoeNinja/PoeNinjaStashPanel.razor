@using Sidekick.Apis.PoeNinja.Stash
@using Sidekick.Common.Settings.Languages
@using Sidekick.Game.Parser
@using Sidekick.Game.Parser.Properties
@using Sidekick.Game.Parser.Properties.Definitions
@using Sidekick.Game.Parser.Stats
@using Sidekick.Modules.Items.Components
@using Sidekick.Modules.Items.PoeNinja.Localization

<div class="bg-stone-950 rounded-lg px-2 py-1">
    <div class="flex flex-wrap mb-1">
        <div class="flex w-1/3 justify-center">
            <PriceDisplay Value="Stash.ChaosValue" Currency="chaos"/>
        </div>
        <div class="flex w-1/3 justify-center">
            <PriceDisplay Value="Stash.ExaltedValue" Currency="exalted"/>
        </div>
        <div class="flex w-1/3 justify-center">
            <PriceDisplay Value="Stash.DivineValue" Currency="divine"/>
        </div>
    </div>

    @if (Stash.ListingCount < 5)
    {
        <AlertError IsCritical="true" Flat="true">@NinjaResources["LowConfidence"]</AlertError>
    }
    else if (Stash.ListingCount < 10)
    {
        <AlertError IsCritical="false" Flat="true">@NinjaResources["MediumConfidence"]</AlertError>
    }

    @if (Stash.Item.ItemLevel > 0)
    {
        <ItemPropertyText Label="@CurrentGameLanguage.Language.DescriptionItemLevel"
                          Value="@Stash.Item.ItemLevel.ToString()"
                          Class="text-center justify-center"/>
    }

    @if (Stash.Item.GemLevel > 0)
    {
        <ItemPropertyText Label="@CurrentGameLanguage.Language.DescriptionLevel"
                          Value="@Stash.Item.GemLevel.ToString()"
                          Class="text-center justify-center"/>
    }

    @if (Stash.Item.GemQuality > 0)
    {
        <ItemPropertyText Label="@CurrentGameLanguage.Language.DescriptionQuality"
                          Value="@Stash.Item.GemQuality.ToString()"
                          Class="text-center justify-center"/>
    }

    @if (Stash.Item.Stats != null)
    {
        foreach (var stat in Stash.Item.Stats)
        {
            if (string.IsNullOrEmpty(stat.Id)) continue;

            var tradeStats = StatParser.TradeDefinitions.GetValueOrDefault(stat.Id);
            if (tradeStats == null) continue;

            var category = StatCategory.Explicit;
            if (stat.Id.StartsWith("explicit")) category = StatCategory.Mutated;
            if (stat.Id.StartsWith("enchant")) category = StatCategory.Enchant;

            <ItemStatText Category="category" Class="text-center">@tradeStats.FirstOrDefault()?.Text</ItemStatText>
        }
    }

    @if (Stash.Item.Corrupted == true)
    {
        <ItemStatText Category="StatCategory.Corrupted"
                      Class="text-center">@(PropertyParser.GetDefinition<CorruptedProperty>().Label)</ItemStatText>
    }

    <div class="flex flex-nowrap justify-between mt-1">
        <TextCaption>@Stash.ListingCount @NinjaResources["Listings"]</TextCaption>

        @if (!string.IsNullOrEmpty(Stash.Item.Variant))
        {
            <TextCaption>@Stash.Item.Variant.Trim(' ', ',')</TextCaption>
        }
    </div>

    <PoeNinjaWebsite LastUpdated="Stash.LastUpdated" DetailsUrl="Stash.DetailsUrl"/>
    <LayoutDivider Dense="true"/>
    <PoeNinjaSparkline Sparkline="Stash.Sparkline"/>
</div>

@inject IStringLocalizer<PoeNinjaResources> NinjaResources
@inject ICurrentGameLanguage CurrentGameLanguage
@inject PropertyParser PropertyParser
@inject StatParser StatParser

@code {

    [Parameter]
    public required NinjaStash Stash { get; set; }

}
