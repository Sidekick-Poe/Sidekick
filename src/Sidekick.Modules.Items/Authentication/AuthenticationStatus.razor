@using Sidekick.Apis.Poe.Trade.Authentication

<div class="flex flex-nowrap items-center gap-2">
    @if (CurrentState == AuthenticationState.Authenticated)
    {
        <div class="bg-green-500 rounded-full size-2"></div>
        <ButtonLink OnClick="() => AuthenticationService.Authenticate(true)"
                    Class="text-green-600! text-sm!">
            @Resources["Authenticated"] (@TokenRemainingString)
        </ButtonLink>
    }
    else if (CurrentState == AuthenticationState.InProgress)
    {
        <div class="bg-blue-500 rounded-full size-2"></div>
        <ButtonLink OnClick="() => AuthenticationService.Authenticate(true)"
                    Class="text-blue-600! text-sm!">
            @Resources["Authenticating"]
        </ButtonLink>
    }
    else if (CurrentState == AuthenticationState.Unauthenticated)
    {
        <div class="bg-neutral-500 rounded-full size-2"></div>
        <Tooltip Text="@Resources["Unauthenticated_Tooltip"]">
            <ButtonLink OnClick="() => AuthenticationService.Authenticate(true)"
                        Class="text-neutral-400! text-sm!">
                @Resources["Unauthenticated"]
            </ButtonLink>
        </Tooltip>
    }
</div>

@implements IDisposable
@inject IStringLocalizer<AuthenticationResources> Resources
@inject IAuthenticationService AuthenticationService

@code {
    private Timer? refreshTimer;

    private AuthenticationState CurrentState { get; set; }

    private string? TokenRemainingString { get; set; }

    protected override void OnInitialized()
    {
        AuthenticationService.OnStateChanged += OnChanged;

        refreshTimer = new Timer(_ => { OnChanged(); }, null, TimeSpan.Zero, TimeSpan.FromMinutes(1));

        OnChanged();
        base.OnInitialized();
    }

    private void OnChanged()
    {
        InvokeAsync(async () =>
        {
            CurrentState = await AuthenticationService.GetCurrentState();
            var bearerExpiration = await AuthenticationService.GetExpiration();
            if (bearerExpiration == null)
            {
                TokenRemainingString = "";
            }
            else
            {
                var remainingTime = bearerExpiration - DateTimeOffset.Now;
                // Use the total hours so that a token valid for more than a day is not shown as a few hours.
                TokenRemainingString = $"{(int)remainingTime.Value.TotalHours:00}:{remainingTime.Value.Minutes:00}";
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
        AuthenticationService.OnStateChanged -= OnChanged;
    }

}
