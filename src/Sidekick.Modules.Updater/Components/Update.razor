@page "/update"
@page "/"
@using Sidekick.Common.Exceptions
@using Sidekick.Common.Ui.Extensions
@using Velopack

@if (Exception != null)
{
    <UpdateException Exception="Exception"/>
}
else if (Updating)
{
    <UpdateUpdating/>
}
else if (NoUpdates)
{
    <UpdateNoUpdates/>
}
else if (TimedOut)
{
    <UpdateTimedOut/>
}
else if (UpdateInfo != null)
{
    <UpdateReleaseNotes UpdateInfo="UpdateInfo"
                        OnDownload="Download"/>
}
else
{
    <UpdateChecking/>
}

@inject ILogger<Update> Logger
@inject IAutoUpdater AutoUpdater
@inject NavigationManager NavigationManager

@code {

    private bool Updating { get; set; }

    private UpdateInfo? UpdateInfo { get; set; }

    private SidekickException? Exception { get; set; }

    private bool TimedOut { get; set; }

    private bool NoUpdates { get; set; }

    private bool IsInitialization => string.IsNullOrEmpty(NavigationManager.QueryString("back"));

#if DEBUG
    /// <summary>
    /// Development only: set by the Development page to preview the release notes.
    /// </summary>
    private bool IsFakeReleaseNotes => NavigationManager.QueryString("devFakeNotes") == "true";

    private static UpdateInfo CreateFakeUpdateInfo()
    {
        var enhancements = string.Join("", Enumerable.Range(1, 12).Select(i => $"<li>Sample enhancement {i}, with a description long enough to wrap on a second line in the window.</li>"));
        var fixes = string.Join("", Enumerable.Range(1, 8).Select(i => $"<li>Sample bug fix {i}.</li>"));
        var notes = $"<h1>Sidekick 9.9.9</h1><h2>Enhancements</h2><ul>{enhancements}</ul><h2>Bug fixes</h2><ul>{fixes}</ul>";

        var release = new VelopackAsset
        {
            PackageId = "Sidekick",
            Version = SemanticVersion.Parse("9.9.9"),
            FileName = "Sidekick-9.9.9-full.nupkg",
            NotesHTML = notes,
        };

        return new UpdateInfo(release, false, null!, []);
    }
#endif

    protected override async Task OnInitializedAsync()
    {
        _ = Check();
        await base.OnInitializedAsync();

    }

    private async Task Check()
    {
#if DEBUG
        // Development only: show the release notes with sample notes, without checking for updates.
        if (IsFakeReleaseNotes)
        {
            UpdateInfo = CreateFakeUpdateInfo();
            StateHasChanged();
            return;
        }
#endif

        try
        {
            if (AutoUpdater.IsUpdaterInstalled())
            {
                var checkTask = AutoUpdater.CheckForUpdates();
                var completedTask = await Task.WhenAny(checkTask, Task.Delay(TimeSpan.FromSeconds(10)));
                if (completedTask == checkTask)
                {
                    // Completed within timeout
                    UpdateInfo = await checkTask;
                    StateHasChanged();

                    // There's no available updates
                    if (UpdateInfo is null)
                    {
                        if (IsInitialization) NavigationManager.NavigateTo("/setup");
                        NoUpdates = true;
                        StateHasChanged();
                    }
                }
                else
                {
                    // Timed out
                    TimedOut = true;
                    StateHasChanged();
                }
            }
            else
            {
                Logger.LogWarning("[AutoUpdater] UpdateManager is not installed.");
                if (IsInitialization) NavigationManager.NavigateTo("/setup");
                NoUpdates = true;
                StateHasChanged();
            }
        }
        catch (SidekickException e)
        {
            Exception = e;
            StateHasChanged();
        }
        catch (Exception e)
        {
            Exception = new SidekickException(e.Message);
            Logger.LogError(e, "[AutoUpdater] Error while checking for updates.");
            StateHasChanged();
        }
    }

    public async Task Download()
    {
        if (UpdateInfo == null) throw new SidekickException("Could not apply the update successfully.");

#if DEBUG
        // Development only: the sample release notes cannot be installed.
        if (IsFakeReleaseNotes) return;
#endif

        try
        {
            Updating = true;
            StateHasChanged();

            await AutoUpdater.UpdateAndRestart(UpdateInfo);
            Updating = false;
            StateHasChanged();
        }
        catch (SidekickException e)
        {
            Exception = e;
            Updating = false;
            StateHasChanged();
        }
    }

}
