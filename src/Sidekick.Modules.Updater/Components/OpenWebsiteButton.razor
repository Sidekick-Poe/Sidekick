@using Sidekick.Common.Browser
@using Sidekick.Common.Ui.Localization

<ButtonSecondary OnClick="OpenWebsite">@UiResources.Open_Website</ButtonSecondary>

@inject IStringLocalizer<UiResources> UiResources
@inject IBrowserProvider BrowserProvider

@code {

    public void OpenWebsite()
    {
        BrowserProvider.OpenUri(BrowserProvider.SidekickWebsite);
    }

}
