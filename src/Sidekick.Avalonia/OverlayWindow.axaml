<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Sidekick.Avalonia.Controls"
        x:Class="Sidekick.Avalonia.OverlayWindow"
        RequestedThemeVariant="Dark"
        WindowDecorations="Full"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="True">
    <Grid Name="Grid">
        <controls:SidekickWebView Name="WebView" />
    </Grid>
</Window>
