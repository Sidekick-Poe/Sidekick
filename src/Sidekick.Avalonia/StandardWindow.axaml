<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Sidekick.Avalonia.Controls"
        x:Class="Sidekick.Avalonia.StandardWindow"
        WindowDecorations="Full"
        Topmost="False"
        ShowInTaskbar="True"
        CanResize="True"
        CanMaximize="True"
        CanMinimize="True">
    <Grid RowDefinitions="Auto,*">
        <controls:TitleBar Grid.Row="0" />
        <Grid Grid.Row="1"
              Name="Grid">
            <controls:SidekickWebView Name="WebView" />
        </Grid>
    </Grid>
</Window>