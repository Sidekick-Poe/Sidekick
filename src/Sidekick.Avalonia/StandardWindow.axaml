<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Sidekick.Avalonia.Controls"
        x:Class="Sidekick.Avalonia.StandardWindow"
        WindowDecorations="Full"
        Topmost="False"
        ShowInTaskbar="True"
        CanResize="True"
        CanMaximize="True"
        CanMinimize="True">
    <Grid Name="Grid">
        <controls:SidekickWebView Name="WebView" />
    </Grid>
</Window>