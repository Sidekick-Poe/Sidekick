<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sidekick.Avalonia.Controls.TitleBar"
             Height="30"
             Background="#0c0a09"
             WindowDecorationProperties.ElementRole="TitleBar">
    <Grid ColumnDefinitions="Auto,Auto,Auto,*">
        <!-- Logo -->
        <Image Grid.Column="0"
               Width="24"
               Height="24"
               Margin="12,3,0,3"
               Source="/Assets/ExaltedOrb.png"
               Stretch="Uniform" />

        <!-- Title Text -->
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource FontinSmallCapsFont}"
                   FontSize="16"
                   Margin="12,4,0,4"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   Text="Sidekick" />
    </Grid>
</UserControl>