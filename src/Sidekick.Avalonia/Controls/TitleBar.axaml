<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sidekick.Avalonia.Controls.TitleBar"
             Height="30"
             Background="#0c0a09"
             WindowDecorationProperties.ElementRole="TitleBar">
    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
        <Image Width="24"
               Height="24"
               Margin="12,3,12,3"
               Source="/Assets/ExaltedOrb.png"
               Stretch="Uniform" />

        <TextBlock VerticalAlignment="Center"
                   FontFamily="{StaticResource FontinSmallCapsFont}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   Text="Sidekick" />
    </StackPanel>
</UserControl>