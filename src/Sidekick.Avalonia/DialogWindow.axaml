<Window
    x:Class="Sidekick.Avalonia.DialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <Image
                        Width="48"
                        Height="48"
                        Margin="0,0,12,0"
                        Source="Assets/ExaltedOrb.png"
                        Stretch="Uniform" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontinSmallCapsFont}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF"
                        Text="Sidekick" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="1"
                Padding="16"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,1">

                <TextBlock
                    x:Name="MessageTextBlock"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource FontinFont}"
                    FontSize="18"
                    Foreground="#FFFFFF"
                    LineHeight="26"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="2" Padding="16">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">

                    <Button
                        x:Name="CancelButton"
                        FontFamily="{StaticResource FontinFont}"
                        Classes="secondary"
                        Margin="0,0,12,0"
                        Click="CancelButton_Click"
                        Content="Cancel" />

                    <Button
                        x:Name="ConfirmButton"
                        FontFamily="{StaticResource FontinFont}"
                        Classes="primary"
                        Click="ConfirmButton_Click"
                        Content="OK"
                        IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
