@using Sidekick.Apis.GitHub;
@using Sidekick.Apis.GitHub.Models;
@using Sidekick.Common.Ui.Localization

@if (Release is { IsNewerVersion: true })
{
    <AlertInfo>
        <div class="flex flex-nowrap items-center gap-3">
            <TextBase>@Resources["UpdateAvailable"]</TextBase>
            <ButtonLink OnClick="OnClick">@Resources["Update"]</ButtonLink>
        </div>
    </AlertInfo>
}

@inject IGitHubClient GitHubClient
@inject IStringLocalizer<UiResources> Resources
@inject NavigationManager NavigationManager

@code {

    private GitHubRelease? Release { get; set; }

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        Release = await GitHubClient.GetLatestRelease();

        await base.OnInitializedAsync();
    }

    private void OnClick()
    {
        NavigationManager.NavigateTo($"/update?back={Uri.EscapeDataString(NavigationManager.Uri)}");
    }

}
