@if (Active)
{
    <li>
        <button type="button"
                class="flex items-center flex-nowrap gap-1 px-2 py-1 text-violet-400 bg-stone-700 rounded-t-lg active @(string.IsNullOrEmpty(EndIcon) ? "" : "-mr-2")"
                @onclick="SelectTab"
                @onclick:preventDefault="true">
            <TextBase>@Text</TextBase>
            @if (!string.IsNullOrEmpty(EndIcon))
            {
                <Icon Svg="@EndIcon" Size="UiIconSize.Small"/>
            }
        </button>
    </li>
}
else
{
    <li>
        <button type="button"
                class="flex items-center flex-nowrap gap-1 px-2 py-1 rounded-t-lg dark:hover:bg-stone-600 hover:text-gray-300 transition-colors duration-200 @(string.IsNullOrEmpty(EndIcon) ? "" : "-mr-2")"
                @onclick="SelectTab"
                @onclick:preventDefault="true">
            <TextBase>@Text</TextBase>
            @if (!string.IsNullOrEmpty(EndIcon))
            {
                <Icon Svg="@EndIcon" Size="UiIconSize.Small"/>
            }
        </button>
    </li>
}

@implements IDisposable

@code {
    [CascadingParameter]
    public required TabList TabList { get; set; }

    [Parameter]
    public required string Text { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? EndIcon { get; set; }

    private bool Active => TabList.SelectedTab == Id;

    protected override void OnInitialized()
    {
        TabList.SelectedTabChanged += StateHasChanged;
        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (TabList.SelectedTab == null) SelectTab();

        base.OnAfterRender(firstRender);
    }

    private void SelectTab()
    {
        if (Id == null) return;
        TabList.SelectedTab = Id;
    }

    public void Dispose()
    {
        TabList.SelectedTabChanged -= StateHasChanged;
    }
}