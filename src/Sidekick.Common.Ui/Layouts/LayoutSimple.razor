<div class="h-full flex flex-col justify-center dark:bg-stone-950">
    <AppMoveHandle Class="p-4">
        <AppLogo/>
    </AppMoveHandle>
    <div class="grow overflow-y-auto overflow-x-hidden">
        <div class="flex flex-col justify-center min-h-full">
            <div class="w-full p-4">
                @ChildContent
            </div>
        </div>
    </div>
    @if (BottomContent != null)
    {
        <div class="p-4">
            @BottomContent
        </div>
    }
</div>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? BottomContent { get; set; }

}