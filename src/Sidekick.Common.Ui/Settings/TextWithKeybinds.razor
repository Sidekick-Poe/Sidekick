@RenderText()

@code {

    /// <summary>
    /// A typed resource with one placeholder, like Resources.Close_Overlay_Tip. The placeholder is shown as the keybind.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public Func<object, string> Format { get; set; } = null!;

    [Parameter]
    public string? Keybind { get; set; }

    /// <summary>
    /// Passed as the placeholder value so the translated text can be split around it. Never shown.
    /// </summary>
    private const string Marker = "\u0001";

    private RenderFragment RenderText() => builder =>
    {
        var parts = Format(Marker).Split(Marker);
        var sequence = 0;

        for (var i = 0; i < parts.Length; i++)
        {
            builder.AddContent(sequence++, parts[i]);
            if (i == parts.Length - 1)
            {
                continue;
            }

            builder.OpenComponent<KeybindDisplay>(sequence++);
            builder.AddAttribute(sequence++, "Keybind", Keybind);
            builder.CloseComponent();
        }
    };

}
