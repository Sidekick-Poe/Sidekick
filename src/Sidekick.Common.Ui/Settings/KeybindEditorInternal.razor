@using Sidekick.Common.Platform
@using Sidekick.Common.Ui.Localization
@implements IAsyncDisposable

<div>
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="flex gap-1 mb-1 text-base font-medium dark:text-zinc-300"
               @onclick="Activate">
            @Label
            @if (Tooltip is not null)
            {
                <Tooltip Text="@Tooltip"/>
            }
        </label>
    }

    <div class="flex flex-nowrap items-center gap-1">
        <div id="@Id"
             class="min-w-40 grow p-2 text-left cursor-pointer select-none @UiClasses.FormInputClasses @(IsActive ? "ring-2 ring-violet-400" : "")"
             @onclick="Activate">
            <KeybindDisplay Keybind="@InputValue"/>
        </div>

        @if (ShowClearButton)
        {
            <ButtonIcon OnClick="Clear"
                        Svg="@Lucide.X"
                        Tooltip="@Resources.Clear"/>
        }

        @AdornmentContent
    </div>

    @if (Warning != null)
    {
        <label class="mt-1 text-base font-medium text-amber-500 flex items-center flex-nowrap gap-2">
            <Icon Svg="@Lucide.TriangleExclamationPoint" Size="@UiIconSize.Medium"/>
            <TextWithKeybinds Format="@Warning" Keybind="@WarningKeybind"/>
        </label>
    }
</div>

@inject IStringLocalizer<UiResources> Resources
@inject IInputProvider Input
@inject SafeJsRuntime JsRuntime

@code {

    [Parameter]
    public required string Label { get; set; }

    [Parameter]
    public string? Tooltip { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public RenderFragment? AdornmentContent { get; set; }

    /// <summary>
    /// Only one editor listens for a key at a time.
    /// </summary>
    private static KeybindEditorInternal? ActiveEditor { get; set; }

    private bool IsActive => ActiveEditor == this;

    private static event Action? CurrentEditorChanged;

    private bool ShowClearButton => !string.IsNullOrWhiteSpace(Value);

    protected string Id { get; } = UiUtilities.GenerateId();

    /// <summary>
    /// The text of the warning shown under the field when the pressed key can't be used.
    /// </summary>
    private Func<object, string>? Warning { get; set; }

    private string? WarningKeybind { get; set; }

    private DotNetObjectReference<KeybindEditorInternal>? DotNetReference { get; set; }

    private SafeJsObjectReference? Recorder { get; set; }

    private string? InputValue
    {
        get
        {
            if (IsActive)
            {
                return Resources.Keybind_Active;
            }

            return string.IsNullOrEmpty(Value) ? Resources.Keybind_Unset : Value;
        }
    }

    protected override void OnInitialized()
    {
        Input.OnKeyDown += OnKeyDown;
        Input.OnRecordingKeybindStopped += OnRecordingKeybindStopped;
        CurrentEditorChanged += OnCurrentEditorChanged;
        base.OnInitialized();
    }

    /// <summary>
    /// The event is shared by the editors of every window, like the settings opened in the overlay and in the main
    /// window, and each window renders on its own thread, so the editor switches to its own thread before rendering.
    /// </summary>
    private void OnCurrentEditorChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task Activate()
    {
        if (IsActive) return;

        ActiveEditor = this;
        Input.IsRecordingKeybind = true;
        CurrentEditorChanged?.Invoke();

        DotNetReference ??= DotNetObjectReference.Create(this);
        var recorder = await JsRuntime.InvokeObjectAsync("sidekick.forms.keybindRecorder", Id, DotNetReference, nameof(Deactivate));
        if (IsActive)
        {
            Recorder = recorder;
            return;
        }

        // A key was pressed while the recorder was starting, so the editor already stopped listening.
        if (recorder == null) return;
        await recorder.InvokeVoidAsync("dispose");
        await recorder.DisposeAsync();
    }

    [JSInvokable]
    public async Task Deactivate()
    {
        if (Recorder != null)
        {
            await Recorder.InvokeVoidAsync("dispose");
            await Recorder.DisposeAsync();
            Recorder = null;
        }

        if (!IsActive) return;

        ActiveEditor = null;
        Input.IsRecordingKeybind = false;
        CurrentEditorChanged?.Invoke();
    }

    private void OnRecordingKeybindStopped()
    {
        InvokeAsync(Deactivate);
    }

    private void OnKeyDown(string key)
    {
        InvokeAsync(async () =>
        {
            if (!IsActive)
            {
                return;
            }

            if (key != "Esc")
            {
                WarningKeybind = key;
                if (key == Value)
                {
                    Warning = null;
                }
                else if (GameKeybinds.Reserved.Contains(key))
                {
                    Warning = Resources.Keybind_Reserved;
                }
                else if (Input.UsedKeybinds.Contains(key))
                {
                    Warning = Resources.Keybind_Already_In_Use;
                }
                else
                {
                    Warning = null;
                    await ValueChanged.InvokeAsync(key);
                }
            }

            await Deactivate();
            StateHasChanged();
        });
    }

    public async Task Clear()
    {
        Warning = null;
        await Deactivate();
        await ValueChanged.InvokeAsync("");
    }

    public async ValueTask DisposeAsync()
    {
        Input.OnKeyDown -= OnKeyDown;
        Input.OnRecordingKeybindStopped -= OnRecordingKeybindStopped;
        CurrentEditorChanged -= OnCurrentEditorChanged;
        await Deactivate();
        DotNetReference?.Dispose();
    }

}
