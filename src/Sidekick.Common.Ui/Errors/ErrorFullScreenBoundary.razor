@using Sidekick.Common.Exceptions
@using Sidekick.Common.Platform
@using Sidekick.Common.Ui.Buttons
@using Sidekick.Common.Ui.Localization

<SidekickErrorBoundary @ref="ErrorBoundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent>
        @{
            var title = context.SidekickException?.Message ?? Resources["Error_Unexpected_Title"];
            var details = context.SidekickException != null ? context.AdditionalInformation : [Resources["Error_Unexpected_Description"]];
            var itemText = context.SidekickException?.ItemText;
            var isLeftAligned = !string.IsNullOrEmpty(itemText);

            var actions = context.SidekickException?.Actions ?? 0;
            if (actions == 0) actions = ExceptionActions.CloseWindow;
        }

        <div class="fixed top-0 left-0 h-full w-full overflow-auto">
            <div class="flex min-h-full items-center justify-center p-4">
                <div class="w-full max-w-lg rounded-xl border border-stone-700 bg-stone-900 p-6 shadow-lg @(isLeftAligned ? "text-left" : "text-center")">
                    <div class="mx-auto mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-stone-800 @(context.IsCritical ? "text-red-500" : "text-orange-500")">
                        <Icon Svg="@(context.IsCritical ? UiIcons.Error : UiIcons.Warning)" Size="@UiIconSize.Large" />
                    </div>

                    <Heading2 Class="text-white leading-snug text-center">@title</Heading2>

                    @foreach (var detail in details)
                    {
                        <TextBase Class="mt-3 text-stone-300">@detail</TextBase>
                    }

                    @if (!string.IsNullOrWhiteSpace(itemText))
                    {
                        <label class="mt-4 block">
                            <TextBase Class="text-stone-300">@Resources["Error_Item_Text"]</TextBase>
                            <textarea readonly class="@UiClasses.FormInputClasses mt-2 h-48 w-full resize-none p-2 text-sm">@itemText</textarea>
                        </label>
                    }

                    <div class="mt-6 flex items-center justify-center gap-2">
                        @if (actions.HasFlag(ExceptionActions.ExitApplication))
                        {
                            <ButtonSecondary OnClick="ApplicationService.Shutdown">@Resources["Exit"]</ButtonSecondary>
                        }
                        @if (actions.HasFlag(ExceptionActions.CloseWindow))
                        {
                            <ButtonPrimary OnClick="Close">@Resources["Close"]</ButtonPrimary>
                        }
                    </div>
                </div>
            </div>
        </div>
    </ErrorContent>
</SidekickErrorBoundary>

@inject CurrentView CurrentView
@inject IApplicationService ApplicationService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<UiResources> Resources
@implements IDisposable

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private SidekickErrorBoundary? ErrorBoundary { get; set; }

    protected override void OnInitialized()
    {
        // Any navigation leaves the error page, for example when the window is reopened from the tray after being closed with its X button.
        NavigationManager.LocationChanged += RecoverOnNavigation;
        base.OnInitialized();
    }

    private void RecoverOnNavigation(object? sender, LocationChangedEventArgs e)
    {
        if (ErrorBoundary?.Exception == null) return;

        ErrorBoundary.Recover();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= RecoverOnNavigation;
    }

    private void Close()
    {
        NavigationManager.LocationChanged += RecoverAfterNavigation;
        NavigationManager.NavigateTo("/empty");
    }

    private void RecoverAfterNavigation(object? sender, LocationChangedEventArgs e)
    {
        ErrorBoundary?.Recover();
        NavigationManager.LocationChanged -= RecoverAfterNavigation;
        CurrentView.Close();
    }

}
