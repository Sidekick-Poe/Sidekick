@using Microsoft.Extensions.Localization
@using Sidekick.Common.Settings
@using Sidekick.Common.Ui.Forms
@using Blazicons
@using Sidekick.Common.Ui.Buttons
@using Sidekick.Common.Ui.Localization
@using Sidekick.Modules.General.Localization

<FormSelect Value="@Value"
            ValueChanged="ValueChanged"
            Label="@Resources.Zoom"
            Options="Options"
            Tooltip="@Resources.Zoom_Hint">
    <AdornmentContent>
        @if (ShowResetButton)
        {
            <ButtonIcon OnClick="Reset"
                        Svg="@Lucide.RotateCcw"
                        Tooltip="@UiResources.Reset"/>
        }
    </AdornmentContent>
</FormSelect>

@inject IStringLocalizer<UiResources> UiResources
@inject IStringLocalizer<GeneralResources> Resources
@inject ISettingsService SettingsService
@implements IDisposable

@code {

    private string? Value { get; set; }

    private List<SelectOption> Options { get; set; } = new();

    private const string SettingKey = SettingKeys.Zoom;

    private bool ShowResetButton { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Value = await SettingsService.GetStringAsync(SettingKey);
        ShowResetButton = await SettingsService.IsSettingModifiedAsync(SettingKey);

        SettingsService.OnSettingsChanged += OnSettingsChanged;

        Options =
        [
            new()
            {
                Label = "75%",
                Value = "0.75",
            },
            // 87.5% matches the text sizes used before the switch to the standard Tailwind text sizes.
            new()
            {
                Label = "87.5%",
                Value = "0.875",
            },
            new()
            {
                Label = "100%",
                Value = "1",
            },
            new()
            {
                Label = "125%",
                Value = "1.25",
            },
            new()
            {
                Label = "150%",
                Value = "1.5",
            },
            new()
            {
                Label = "175%",
                Value = "1.75",
            },
            new()
            {
                Label = "200%",
                Value = "2",
            },
        ];

        await base.OnInitializedAsync();
    }

    private async Task ValueChanged(string? value)
    {
        Value = value;

        await SettingsService.SetAsync(SettingKey, value);
    }

    private async void OnSettingsChanged(string[] keys)
    {
        if (!keys.Contains(SettingKey)) return;

        Value = await SettingsService.GetStringAsync(SettingKey);
        ShowResetButton = await SettingsService.IsSettingModifiedAsync(SettingKey);
        await InvokeAsync(StateHasChanged);
    }

    private async Task Reset()
    {
        await SettingsService.DeleteSettingAsync(SettingKey);
    }

    public void Dispose()
    {
        SettingsService.OnSettingsChanged -= OnSettingsChanged;
    }

}


