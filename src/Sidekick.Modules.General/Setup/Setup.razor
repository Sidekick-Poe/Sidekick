@page "/setup"
@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using Sidekick.Common.Cache
@using Sidekick.Common.Debugging
@using Sidekick.Common.Exceptions
@using Sidekick.Common.Extensions
@using Sidekick.Common.Platform
@using Sidekick.Common.Settings
@using Sidekick.Common.Ui.Views
@using Sidekick.Common.Ui.Extensions
@using Sidekick.Common.Ui.Localization
@using Sidekick.Common.Ui.Layouts
@using Sidekick.Common.Ui.App
@using Sidekick.Common.Ui.Alerts
@using Sidekick.Common.Ui.Typography
@using Sidekick.Common.Ui.Progress
@using Sidekick.Common.Ui.Buttons
@using Sidekick.Game.Providers
@using Sidekick.Modules.General.Settings.Components

<LayoutSimple>
    <ChildContent>
        @if (Exception != null)
        {
            <AppContainer>
                <AlertException Exception="Exception"/>
            </AppContainer>
        }
        else if (RequiresSetup)
        {
            if (NewLeagues)
            {
                <AlertInfo>@Resources["New_League_Alert"]</AlertInfo>
            }

            @if (FormInvalid)
            {
                <AlertError>@Resources["Valid_Language_Alert"]</AlertError>
            }

            <AppContainer>
                <div class="flex flex-col gap-3">
                    <LanguageParserEditor/>
                    <LeagueIdEditor AutoRefresh="false"/>
                </div>
            </AppContainer>
        }
        else
        {
            <AppContainer>
                <Heading3 Class="mb-2 text-center">@Resources["Loading"]</Heading3>
                <ProgressBar Indeterminate="true"/>
            </AppContainer>
        }
    </ChildContent>
    <BottomContent>
        @if (RequiresSetup)
        {
            <div class="px-3 py-2 flex justify-center gap-2">
                <ButtonSecondary OnClick="Exit">
                    @ExitLabel
                </ButtonSecondary>
                <ButtonPrimary OnClick="() => Save()">
                    @Resources["Save"]
                </ButtonPrimary>
            </div>
        }
        else
        {
            <div class="px-3 py-2 flex justify-center gap-2">
                <ButtonSecondary OnClick="Exit">
                    @ExitLabel
                </ButtonSecondary>
            </div>
        }
    </BottomContent>
</LayoutSimple>

@inject ISettingsService SettingsService
@inject IApplicationService ApplicationService
@inject LeagueProvider LeagueProvider
@inject ICacheProvider CacheProvider
@inject IStringLocalizer<Setup> Resources
@inject IStringLocalizer<UiResources> UiResources
@inject NavigationManager NavigationManager
@inject CurrentView CurrentView
@inject ILogger<Setup> Logger
@inject DebugService DebugService
@implements IDisposable

@code {

    private const int FORM_WIDTH = 520;
    private const int FORM_HEIGHT = 480;

    public void Dispose()
    {
        if (RequiresSetup) CurrentView.ResetSize();
    }

    private bool RequiresSetup { get; set; }

    private bool NewLeagues { get; set; }

    private bool FormInvalid { get; set; }

    private SidekickException? Exception { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _ = Check();
        await base.OnInitializedAsync();
    }

    public async Task Check()
    {
        try
        {
            var leagues = await LeagueProvider.GetLeagues();
            var apiLeaguesHash = JsonSerializer.Serialize(leagues).GetDeterministicHashCode();
            var settingsLeaguesHash = await SettingsService.GetInt(SettingKeys.LeaguesHash);
            if (apiLeaguesHash != settingsLeaguesHash)
            {
                NewLeagues = true;
                await CacheProvider.Clear();
            }

            // In debug mode, the form always shows, with the new leagues alert, so it can be checked from the Development page.
            if (DebugService.IsDebug) NewLeagues = true;

            // Check to see if we should run Setup first before running the rest of the initialization process
            var leagueId = await SettingsService.GetString(SettingKeys.LeagueId);
            var parserLanguage = await SettingsService.GetString(SettingKeys.LanguageParser);
            if (DebugService.IsDebug || string.IsNullOrEmpty(leagueId) || leagues.All(x => x.Value != leagueId) || NewLeagues || parserLanguage == null)
            {
                RequiresSetup = true;
                CurrentView.SetSize(FORM_WIDTH, FORM_HEIGHT);
            }
            else
            {
                var silentStart = await SettingsService.GetBool(SettingKeys.SilentStart);
                if (silentStart)
                {
                    CurrentView.Close();
                }

                NavigationManager.NavigateTo("/initialize");
            }

            StateHasChanged();
        }
        catch (SidekickException e)
        {
            Exception = e;
            Logger.LogError(e, "[Setup] Error while checking for setup.");
            StateHasChanged();
        }
        catch (Exception e)
        {
            Exception = new SidekickException(e.Message);
            Logger.LogError(e, "[Setup] Error while checking for setup.");
            StateHasChanged();
        }

    }

    /// <summary>
    /// The back parameter means the setup was opened while Sidekick is running, not at startup.
    /// </summary>
    private bool IsOpenedLater => !string.IsNullOrEmpty(NavigationManager.QueryString("back"));

    private string ExitLabel => IsOpenedLater ? UiResources["Close"] : Resources["Exit"];

    public void Exit()
    {
        if (IsOpenedLater)
        {
            CurrentView.Close();
            return;
        }

        ApplicationService.Shutdown();
    }

    public async Task Save()
    {
        var leagueId = await SettingsService.GetString(SettingKeys.LeagueId);
        var leagues = await LeagueProvider.GetLeagues();
        if (leagues.All(x => x.Value != leagueId))
        {
            FormInvalid = true;
            return;
        }

        var apiLeaguesHash = JsonSerializer.Serialize(leagues).GetDeterministicHashCode();
        await SettingsService.Set(SettingKeys.LeaguesHash, apiLeaguesHash);

        // In debug mode, the app is already initialized, so the window only closes.
        if (DebugService.IsDebug)
        {
            CurrentView.Close();
            return;
        }

        NavigationManager.NavigateTo("/initialize");
    }

}
